# Production settings template. On the server:
#   cp backend/.env.prod.sample backend/.env   → replace every CHANGE_ME
# This file is public (git): never put real secrets here.
# Generate each secret separately:  openssl rand -hex 32

PROJECT_NAME=Online Cinema
# true would log every SQL query and show tracebacks to clients.
DEBUG=false

# Read by the postgres container only on the FIRST start (empty volume);
# changing it later does not change the password inside the database.
POSTGRES_USER=cinema
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=cinema
# Overridden to `db` / `redis` in docker-compose.prod.yaml.
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

ACTIVATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# Gmail: a separate account with 2FA + App Password (16 chars, no spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME@gmail.com
SMTP_PASSWORD=CHANGE_ME
SMTP_USE_TLS=true
# Gmail rewrites any other sender to SMTP_USER: keep them equal.
EMAIL_FROM=CHANGE_ME@gmail.com

# Links in emails and Stripe success/cancel pages.
FRONTEND_URL=https://zubarev-cinema.duckdns.org

# Signs JWT: anyone who knows it can log in as any user.
# openssl rand -hex 64
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Refresh cookie is sent only over HTTPS.
COOKIE_SECURE=true

# MinIO is reachable only inside the compose network, so the app uses the
# root account (S3_* = MINIO_ROOT_*). Password: at least 8 characters.
MINIO_ROOT_USER=cinema
MINIO_ROOT_PASSWORD=CHANGE_ME
S3_ACCESS_KEY=cinema
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET_NAME=avatars
# Host in presigned URLs: nginx proxies /avatars/ to MinIO keeping this Host.
S3_PUBLIC_ENDPOINT_URL=https://zubarev-cinema.duckdns.org
S3_REGION=us-east-1

PENDING_ORDER_EXPIRE_DAYS=7

# Stripe sandbox (test mode): Developers → API keys → Secret key.
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
# Webhook destination https://zubarev-cinema.duckdns.org/api/v1/payments/webhook
# (step 8.7) → Signing secret. NOT the secret from `stripe listen`.
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
