# Template: at container start the nginx image replaces ${DOMAIN} with the
# environment variable and writes the result to /etc/nginx/conf.d/default.conf.
# nginx's own variables ($host, $uri, ...) are left untouched.

# Docker's built-in DNS: lets nginx find the current IP of web / minio
# after those containers are recreated by a deploy.
resolver 127.0.0.11 valid=10s ipv6=off;

upstream backend {
    zone backend 64k;
    server web:8000 resolve;
}

upstream storage {
    zone storage 64k;
    server minio:9000 resolve;
}

# Brute force / email spam protection: 10 requests per minute per client IP.
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;

server_tokens off;

# ---------- HTTP: only certificate renewal and redirect to HTTPS ----------
server {
    listen 80;
    server_name ${DOMAIN};

    # Let's Encrypt checks domain ownership here (certbot --webroot).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------- HTTPS: the application ----------
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Poster upload is up to 5 MB (MAX_POSTER_SIZE) + multipart overhead;
    # the nginx default of 1 MB would reject it with 413.
    client_max_body_size 6m;

    # Inherited by every location below that proxies a request.
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Endpoints that check a password or send an email.
    location ~ ^/api/v1/accounts/(login|register|activation/resend|password-reset/request|change-password)$ {
        limit_req zone=auth burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://backend;
    }

    location /api/ {
        proxy_pass http://backend;
    }

    # Files from MinIO. The path = S3_BUCKET_NAME; Host is kept,
    # so presigned URL signatures stay valid.
    location /avatars/ {
        proxy_pass http://storage;
    }

    # ---------- SPA ----------
    root /usr/share/nginx/html;

    # Vite puts a content hash in file names: safe to cache forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # index.html must always be fresh, otherwise a deploy is not picked up.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # /movies, /cart, ... exist only in React Router: fall back to index.html.
    location / {
        try_files $uri /index.html;
    }
}
